{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/medication-schema.json",
  "title": "Remote medication monograph definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "status",
    "formularyGroup",
    "medicineType",
    "drugClass",
    "summary",
    "indications",
    "contraindications",
    "cautions",
    "interactions",
    "sideEffects",
    "renalConsiderations",
    "hepaticConsiderations",
    "pregnancyBreastfeeding",
    "practicalPoints",
    "references",
    "clinicalValidation",
    "aliases",
    "updatedOn",
    "changeSummary",
    "effectiveFrom"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "$ref": "#/$defs/stringList"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "active",
        "withdrawn"
      ]
    },
    "isPenicillin": {
      "type": "boolean",
      "default": false
    },
    "formularyGroup": {
      "type": "string",
      "minLength": 1
    },
    "medicineType": {
      "type": "string",
      "minLength": 1
    },
    "drugClass": {
      "type": "string",
      "minLength": 1
    },
    "bnfLookupName": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional BNF lookup/source name when it differs from the medication display title."
    },
    "summary": {
      "type": "string"
    },
    "updatedOn": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "changeSummary": {
      "type": [
        "string",
        "null"
      ]
    },
    "effectiveFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "indications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/indication"
      }
    },
    "contraindications": {
      "$ref": "#/$defs/stringList"
    },
    "cautions": {
      "$ref": "#/$defs/stringList"
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/medicationInteraction"
      }
    },
    "renalConsiderations": {
      "$ref": "#/$defs/stringList"
    },
    "hepaticConsiderations": {
      "$ref": "#/$defs/stringList"
    },
    "pregnancyBreastfeeding": {
      "$ref": "#/$defs/stringList"
    },
    "practicalPoints": {
      "$ref": "#/$defs/stringList"
    },
    "references": {
      "allOf": [
        {
          "$ref": "#/$defs/stringList"
        },
        {
          "uniqueItems": true
        }
      ]
    },
    "clinicalValidation": {
      "$ref": "#/$defs/clinicalValidation"
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clinicalAttachment"
      },
      "default": []
    },
    "prominentResources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prominentResource"
      },
      "default": []
    },
    "sideEffects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/medicationSideEffectGroup"
      },
      "default": []
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "medicationInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drug",
        "description",
        "severity",
        "evidence"
      ],
      "properties": {
        "drug": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "medicationSideEffectGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency",
        "effects"
      ],
      "properties": {
        "frequency": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "indicationRegimen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "dose",
        "route",
        "frequency",
        "duration",
        "prescribingPathwayId",
        "prescribingChoiceLabel"
      ],
      "properties": {
        "population": {
          "type": [
            "string",
            "null"
          ]
        },
        "dose": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "frequency": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "prescribingPathwayId": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "prescribingChoiceLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "indication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "notes",
        "regimens"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "$ref": "#/$defs/stringList"
        },
        "regimens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indicationRegimen"
          }
        }
      }
    },
    "clinicalValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validated",
        "reviewedBy",
        "reviewedOn",
        "reviewerRole",
        "nextReviewDue",
        "reviewNotes"
      ],
      "properties": {
        "validated": {
          "type": "boolean"
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewerRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextReviewDue": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewNotes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "clinicalAttachmentReplacementGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacedOn",
        "replacedBy",
        "replacementReason",
        "changeSummary",
        "clinicalMeaningChanged",
        "requiresRevalidation",
        "sourceChecked",
        "previousPath",
        "previousVersion",
        "previousSha256"
      ],
      "properties": {
        "replacedOn": {
          "type": "string",
          "format": "date-time"
        },
        "replacedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementReason": {
          "type": "string",
          "minLength": 1
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1
        },
        "clinicalMeaningChanged": {
          "type": "boolean"
        },
        "requiresRevalidation": {
          "type": "boolean"
        },
        "sourceChecked": {
          "type": "boolean"
        },
        "previousPath": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "previousVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "previousSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "clinicalAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "label",
        "path",
        "caption",
        "source",
        "referenceId",
        "version",
        "sha256",
        "mediaType",
        "originalFileName",
        "fileSize",
        "width",
        "height",
        "uploadedOn",
        "uploadedBy",
        "replacementGovernance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "image",
            "pdf",
            "document",
            "spreadsheet",
            "presentation",
            "text"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "originalFileName": {
          "type": "string",
          "minLength": 1
        },
        "fileSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "uploadedOn": {
          "type": "string",
          "format": "date-time"
        },
        "uploadedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementGovernance": {
          "anyOf": [
            {
              "$ref": "#/$defs/clinicalAttachmentReplacementGovernance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "prominentResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "sourceType"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "url",
            "attachment"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "attachmentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "url"
              }
            },
            "required": [
              "sourceType"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "attachment"
              }
            },
            "required": [
              "sourceType"
            ]
          },
          "then": {
            "required": [
              "attachmentId"
            ]
          }
        }
      ]
    }
  }
}
