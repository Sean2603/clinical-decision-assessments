{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/medication-schema.json",
  "title": "Remote medication monograph definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "status",
    "formularyGroup",
    "medicineType",
    "drugClass",
    "summary",
    "indications",
    "contraindications",
    "cautions",
    "interactions",
    "renalConsiderations",
    "hepaticConsiderations",
    "pregnancyBreastfeeding",
    "practicalPoints",
    "references",
    "clinicalValidation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "active",
        "withdrawn",
        "superseded"
      ]
    },
    "formularyGroup": {
      "type": "string",
      "minLength": 1
    },
    "medicineType": {
      "type": "string",
      "minLength": 1
    },
    "drugClass": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "indications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/indication"
      }
    },
    "contraindications": {
      "$ref": "#/$defs/stringList"
    },
    "cautions": {
      "$ref": "#/$defs/stringList"
    },
    "interactions": {
      "$ref": "#/$defs/stringList"
    },
    "renalConsiderations": {
      "$ref": "#/$defs/stringList"
    },
    "hepaticConsiderations": {
      "$ref": "#/$defs/stringList"
    },
    "pregnancyBreastfeeding": {
      "$ref": "#/$defs/stringList"
    },
    "practicalPoints": {
      "$ref": "#/$defs/stringList"
    },
    "references": {
      "allOf": [
        {
          "$ref": "#/$defs/stringList"
        },
        {
          "uniqueItems": true
        }
      ]
    },
    "clinicalValidation": {
      "$ref": "#/$defs/clinicalValidation"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "indication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "population",
        "dose",
        "duration",
        "notes"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": [
            "string",
            "null"
          ]
        },
        "dose": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "clinicalValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validated",
        "reviewedBy",
        "reviewedOn",
        "reviewerRole",
        "nextReviewDue",
        "reviewNotes"
      ],
      "properties": {
        "validated": {
          "type": "boolean"
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewerRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextReviewDue": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewNotes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
