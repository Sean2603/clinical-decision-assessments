{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/clinical-notices-schema.json",
  "title": "Clinical notices document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "notices"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clinicalAttachment"
      },
      "default": []
    }
  },
  "$defs": {
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "message",
        "effectiveFrom",
        "expiresOn",
        "requiresAcknowledgement",
        "affectedContentType",
        "affectedContentId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "information",
            "important",
            "urgent",
            "critical"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "effectiveFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expiresOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "requiresAcknowledgement": {
          "type": "boolean"
        },
        "affectedContentType": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "assessment",
            "guideline",
            "scoring-tool",
            "blood-panel",
            "medication",
            "prescribing",
            null
          ]
        },
        "affectedContentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clinicalImageAttachment"
          },
          "default": []
        }
      }
    },
    "clinicalImageAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "label",
        "path",
        "imageVersion",
        "sha256",
        "mimeType",
        "uploadedOn",
        "uploadedBy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^images/(assessments|guidelines|scoring_tools|blood_panels|medications|prescribing|clinical_notices)/[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|webp)$"
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mimeType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "fileSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "uploadedOn": {
          "type": "string",
          "format": "date-time"
        },
        "uploadedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementGovernance": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "replacedOn",
            "replacedBy",
            "replacementReason",
            "changeSummary",
            "clinicalMeaningChanged",
            "requiresRevalidation",
            "sourceChecked",
            "previousPath",
            "previousImageVersion",
            "previousSha256"
          ],
          "properties": {
            "replacedOn": {
              "type": "string",
              "format": "date-time"
            },
            "replacedBy": {
              "type": "string",
              "minLength": 1
            },
            "replacementReason": {
              "type": "string",
              "minLength": 1
            },
            "changeSummary": {
              "type": "string",
              "minLength": 1
            },
            "clinicalMeaningChanged": {
              "type": "boolean"
            },
            "requiresRevalidation": {
              "type": "boolean"
            },
            "sourceChecked": {
              "type": "boolean"
            },
            "previousPath": {
              "type": "string",
              "pattern": "^images/(assessments|guidelines|scoring_tools|blood_panels|medications|prescribing|clinical_notices)/[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|webp)$"
            },
            "previousImageVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "previousSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "clinicalAttachmentReplacementGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacedOn",
        "replacedBy",
        "replacementReason",
        "changeSummary",
        "clinicalMeaningChanged",
        "requiresRevalidation",
        "sourceChecked",
        "previousPath",
        "previousVersion",
        "previousSha256"
      ],
      "properties": {
        "replacedOn": {
          "type": "string",
          "format": "date-time"
        },
        "replacedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementReason": {
          "type": "string",
          "minLength": 1
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1
        },
        "clinicalMeaningChanged": {
          "type": "boolean"
        },
        "requiresRevalidation": {
          "type": "boolean"
        },
        "sourceChecked": {
          "type": "boolean"
        },
        "previousPath": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "previousVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "previousSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "clinicalAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "label",
        "path",
        "caption",
        "source",
        "referenceId",
        "version",
        "sha256",
        "mediaType",
        "originalFileName",
        "fileSize",
        "width",
        "height",
        "uploadedOn",
        "uploadedBy",
        "replacementGovernance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "image",
            "pdf",
            "document",
            "spreadsheet",
            "presentation",
            "text"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "originalFileName": {
          "type": "string",
          "minLength": 1
        },
        "fileSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "uploadedOn": {
          "type": "string",
          "format": "date-time"
        },
        "uploadedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementGovernance": {
          "anyOf": [
            {
              "$ref": "#/$defs/clinicalAttachmentReplacementGovernance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
