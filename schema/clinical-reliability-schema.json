{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clinical reliability document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "updatedAt",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clinicalAttachment"
      },
      "default": []
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "category",
        "contentVersion",
        "reviewStatus",
        "reviewedBy",
        "reviewerRole",
        "lastReviewed",
        "nextReviewDue",
        "reviewNotes",
        "referenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "scoring-tool",
            "blood-panel"
          ]
        },
        "contentVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "unverified",
            "current",
            "review-due",
            "withdrawn"
          ]
        },
        "reviewedBy": {
          "$ref": "#/$defs/nullableString"
        },
        "reviewerRole": {
          "$ref": "#/$defs/nullableString"
        },
        "lastReviewed": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "nextReviewDue": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewNotes": {
          "$ref": "#/$defs/nullableString"
        },
        "referenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "clinicalAttachmentReplacementGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacedOn",
        "replacedBy",
        "replacementReason",
        "changeSummary",
        "clinicalMeaningChanged",
        "requiresRevalidation",
        "sourceChecked",
        "previousPath",
        "previousVersion",
        "previousSha256"
      ],
      "properties": {
        "replacedOn": {
          "type": "string",
          "format": "date-time"
        },
        "replacedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementReason": {
          "type": "string",
          "minLength": 1
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1
        },
        "clinicalMeaningChanged": {
          "type": "boolean"
        },
        "requiresRevalidation": {
          "type": "boolean"
        },
        "sourceChecked": {
          "type": "boolean"
        },
        "previousPath": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "previousVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "previousSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "clinicalAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "label",
        "path",
        "caption",
        "source",
        "referenceId",
        "version",
        "sha256",
        "mediaType",
        "originalFileName",
        "fileSize",
        "width",
        "height",
        "uploadedOn",
        "uploadedBy",
        "replacementGovernance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "image",
            "pdf",
            "document",
            "spreadsheet",
            "presentation",
            "text"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "originalFileName": {
          "type": "string",
          "minLength": 1
        },
        "fileSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "uploadedOn": {
          "type": "string",
          "format": "date-time"
        },
        "uploadedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementGovernance": {
          "anyOf": [
            {
              "$ref": "#/$defs/clinicalAttachmentReplacementGovernance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
