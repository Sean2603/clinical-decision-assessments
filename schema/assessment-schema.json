{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/assessment-schema.json",
  "title": "Clinical Assessment Guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "summary",
    "sections",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "lastReviewed": {
      "type": "string",
      "format": "date"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "prompt-list",
            "examination-guide",
            "common-findings",
            "imaging-guidance",
            "safety-netting",
            "reference"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "howToTest": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "normal": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "abnormal": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mustConfirmOrExclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commonFindings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "imagingGuidance": {
          "$ref": "#/$defs/imagingGuidance"
        },
        "urgentFeatures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "safetyNetting": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "importantLimitation": {
          "type": "string"
        },
        "localPathwayNote": {
          "type": "string"
        }
      }
    },
    "imagingGuidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routineImaging": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "conditional"
          ]
        },
        "preferredImaging": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "urgency": {
          "type": "string",
          "enum": [
            "none",
            "routine",
            "urgent",
            "immediate"
          ]
        },
        "keyTriggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "guidance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
