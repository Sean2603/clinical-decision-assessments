{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assessment reference document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lastChecked",
    "references"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "lastChecked": {
      "type": "string",
      "format": "date"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clinicalAttachment"
      },
      "default": []
    }
  },
  "$defs": {
    "nullableNonEmptyString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organisation",
        "shortOrganisation",
        "title",
        "referenceNumber",
        "type",
        "url",
        "published",
        "lastUpdated",
        "accessed",
        "lastReviewed",
        "reviewStatus",
        "reviewedBy",
        "reviewerRole",
        "nextReviewDue",
        "supersededBy",
        "notes",
        "relevantTopics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "organisation": {
          "type": "string",
          "minLength": 1
        },
        "shortOrganisation": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "referenceNumber": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "guideline",
            "local-guidance",
            "policy",
            "systematic-review",
            "research-paper",
            "professional-statement",
            "textbook",
            "web-resource",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "published": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "lastUpdated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "lastReviewed": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "current",
            "review-due",
            "superseded",
            "withdrawn",
            "unavailable",
            "unverified"
          ]
        },
        "reviewedBy": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "reviewerRole": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "nextReviewDue": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "supersededBy": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "notes": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "relevantTopics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "clinicalAttachmentReplacementGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacedOn",
        "replacedBy",
        "replacementReason",
        "changeSummary",
        "clinicalMeaningChanged",
        "requiresRevalidation",
        "sourceChecked",
        "previousPath",
        "previousVersion",
        "previousSha256"
      ],
      "properties": {
        "replacedOn": {
          "type": "string",
          "format": "date-time"
        },
        "replacedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementReason": {
          "type": "string",
          "minLength": 1
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1
        },
        "clinicalMeaningChanged": {
          "type": "boolean"
        },
        "requiresRevalidation": {
          "type": "boolean"
        },
        "sourceChecked": {
          "type": "boolean"
        },
        "previousPath": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "previousVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "previousSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "clinicalAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "label",
        "path",
        "caption",
        "source",
        "referenceId",
        "version",
        "sha256",
        "mediaType",
        "originalFileName",
        "fileSize",
        "width",
        "height",
        "uploadedOn",
        "uploadedBy",
        "replacementGovernance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "image",
            "pdf",
            "document",
            "spreadsheet",
            "presentation",
            "text"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "originalFileName": {
          "type": "string",
          "minLength": 1
        },
        "fileSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "uploadedOn": {
          "type": "string",
          "format": "date-time"
        },
        "uploadedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementGovernance": {
          "anyOf": [
            {
              "$ref": "#/$defs/clinicalAttachmentReplacementGovernance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
