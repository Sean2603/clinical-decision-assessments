{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/scoring-tool-schema.json",
  "title": "Remote scoring-tool definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "subtitle",
    "version",
    "minimumAppVersion",
    "status",
    "mode",
    "typeLabel",
    "summary",
    "population",
    "exclusions",
    "criteria",
    "results",
    "overrides",
    "limitations",
    "calculationStrategy",
    "referenceIds",
    "clinicalValidation",
    "migration",
    "evaluation",
    "parityCases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "minimumAppVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "withdrawn"
      ]
    },
    "mode": {
      "enum": [
        "calculator",
        "pathway-reference"
      ]
    },
    "typeLabel": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "calculationStrategy": {
      "enum": [
        "sum",
        "custom",
        "none"
      ]
    },
    "referenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "clinicalValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validated",
        "reviewedBy",
        "reviewedOn",
        "reviewerRole",
        "nextReviewDue",
        "reviewNotes"
      ],
      "properties": {
        "validated": {
          "type": "boolean"
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewerRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextReviewDue": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewNotes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "sourceFile",
        "currentScreen",
        "parityStatus",
        "migratedOn"
      ],
      "properties": {
        "state": {
          "const": "shadow"
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1
        },
        "currentScreen": {
          "type": "string",
          "minLength": 1
        },
        "parityStatus": {
          "enum": [
            "pending",
            "matched",
            "mismatch"
          ]
        },
        "migratedOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "evaluation": {
      "type": "object"
    },
    "parityCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "inputs",
          "expectedScore",
          "expectedResultId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "object"
          },
          "expectedScore": {
            "type": "number"
          },
          "expectedResultId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "calculator"
          }
        }
      },
      "then": {
        "properties": {
          "criteria": {
            "minItems": 1
          },
          "results": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "pathway-reference"
          }
        }
      },
      "then": {
        "properties": {
          "calculationStrategy": {
            "const": "none"
          }
        }
      }
    }
  ],
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "value",
        "upperValue",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "<",
            "<=",
            "=",
            ">=",
            ">",
            "between"
          ]
        },
        "value": {
          "type": "number"
        },
        "upperValue": {
          "type": [
            "number",
            "null"
          ]
        },
        "score": {
          "type": "number"
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "inputType",
        "unit",
        "scoreWhenTrue",
        "rules",
        "choices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "inputType": {
          "enum": [
            "boolean",
            "number",
            "choice"
          ]
        },
        "unit": {
          "type": "string"
        },
        "scoreWhenTrue": {
          "type": "number"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "minimumScore",
        "maximumScore",
        "label",
        "interpretation",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "minimumScore": {
          "type": "number"
        },
        "maximumScore": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
