{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sean2603/clinical-decision-assessments/main/schema/scoring-tool-schema.json",
  "title": "Remote scoring-tool definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "subtitle",
    "version",
    "minimumAppVersion",
    "status",
    "mode",
    "typeLabel",
    "summary",
    "population",
    "exclusions",
    "criteria",
    "results",
    "overrides",
    "limitations",
    "calculationStrategy",
    "referenceIds",
    "evaluation",
    "parityCases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "minimumAppVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "withdrawn"
      ]
    },
    "mode": {
      "enum": [
        "calculator",
        "pathway-reference"
      ]
    },
    "typeLabel": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "calculationStrategy": {
      "enum": [
        "sum",
        "custom",
        "none"
      ]
    },
    "referenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "clinicalValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validated"
      ],
      "properties": {
        "validated": {
          "type": "boolean"
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewerRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextReviewDue": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewNotes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "parityCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "inputs",
          "expectedScore",
          "expectedResultId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "object"
          },
          "expectedScore": {
            "type": "number"
          },
          "expectedResultId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clinicalAttachment"
      },
      "default": []
    },
    "prominentResources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prominentResource"
      },
      "default": []
    },
    "alternateModes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "whenOmittedCriterionIds",
          "results"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "whenOmittedCriterionIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/result"
            }
          }
        }
      }
    },
    "escalations": {
      "description": "Governed single-criterion escalations for sum and required-sum evaluations (e.g. the NEWS2 single-parameter 'red score'). After the result band is selected by score, the first escalation in array order whose fromResultIds contains that band, and whose threshold is reached by any single scored criterion, replaces the result with toResultId. The score is unchanged. Never applied to a required-sum prerequisite-failure result. Content using escalations requires app 0.76.3 or later.",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "whenAnyCriterionScoresAtLeast",
          "fromResultIds",
          "toResultId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "whenAnyCriterionScoresAtLeast": {
            "description": "Triggers when any single scored criterion (after the NEWS2 SpO2-scale filter, skipping omitted optional criteria) contributes at least this score.",
            "type": "number"
          },
          "fromResultIds": {
            "description": "The escalation applies only when the band selected by score is one of these result IDs.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "toResultId": {
            "description": "Result shown instead. Resolved within the active alternate mode's results first, then the tool's results.",
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "calculator"
          }
        }
      },
      "then": {
        "properties": {
          "criteria": {
            "minItems": 1
          },
          "results": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "pathway-reference"
          }
        }
      },
      "then": {
        "properties": {
          "calculationStrategy": {
            "const": "none"
          }
        }
      }
    }
  ],
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "value",
        "upperValue",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "<",
            "<=",
            "=",
            ">=",
            ">",
            "between"
          ]
        },
        "value": {
          "type": "number"
        },
        "upperValue": {
          "type": [
            "number",
            "null"
          ]
        },
        "score": {
          "type": "number"
        }
      },
      "if": {
        "properties": {
          "operator": {
            "const": "between"
          }
        },
        "required": [
          "operator"
        ]
      },
      "then": {
        "properties": {
          "upperValue": {
            "type": "number"
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "inputType",
        "unit",
        "scoreWhenTrue",
        "rules",
        "choices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "inputType": {
          "enum": [
            "boolean",
            "number",
            "choice"
          ]
        },
        "unit": {
          "type": "string"
        },
        "scoreWhenTrue": {
          "type": "number"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "minimumScore",
        "maximumScore",
        "label",
        "interpretation",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "minimumScore": {
          "type": "number"
        },
        "maximumScore": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "clinicalAttachmentReplacementGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacedOn",
        "replacedBy",
        "replacementReason",
        "changeSummary",
        "clinicalMeaningChanged",
        "requiresRevalidation",
        "sourceChecked",
        "previousPath",
        "previousVersion",
        "previousSha256"
      ],
      "properties": {
        "replacedOn": {
          "type": "string",
          "format": "date-time"
        },
        "replacedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementReason": {
          "type": "string",
          "minLength": 1
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1
        },
        "clinicalMeaningChanged": {
          "type": "boolean"
        },
        "requiresRevalidation": {
          "type": "boolean"
        },
        "sourceChecked": {
          "type": "boolean"
        },
        "previousPath": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "previousVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "previousSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "clinicalAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "label",
        "path",
        "caption",
        "source",
        "referenceId",
        "version",
        "sha256",
        "mediaType",
        "originalFileName",
        "fileSize",
        "width",
        "height",
        "uploadedOn",
        "uploadedBy",
        "replacementGovernance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "image",
            "pdf",
            "document",
            "spreadsheet",
            "presentation",
            "text"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^attachments/"
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "originalFileName": {
          "type": "string",
          "minLength": 1
        },
        "fileSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "uploadedOn": {
          "type": "string",
          "format": "date-time"
        },
        "uploadedBy": {
          "type": "string",
          "minLength": 1
        },
        "replacementGovernance": {
          "anyOf": [
            {
              "$ref": "#/$defs/clinicalAttachmentReplacementGovernance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "prominentResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "sourceType"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "url",
            "attachment"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "attachmentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "url"
              }
            },
            "required": [
              "sourceType"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "attachment"
              }
            },
            "required": [
              "sourceType"
            ]
          },
          "then": {
            "required": [
              "attachmentId"
            ]
          }
        }
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scoreCriteria",
        "requiredTrue",
        "failureResultId",
        "failureScore",
        "groups",
        "decisionRules"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "sum",
            "required-sum",
            "group-count",
            "decision"
          ]
        },
        "scoreCriteria": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredTrue": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "failureResultId": {
          "type": [
            "string",
            "null"
          ]
        },
        "failureScore": {
          "type": [
            "number",
            "null"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "allTrue",
              "anyTrue"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "allTrue": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              },
              "anyTrue": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              }
            }
          }
        },
        "decisionRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "resultId",
              "score",
              "anyTrue",
              "allTrue",
              "noneTrue",
              "falseCriterion",
              "always"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "resultId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "score": {
                "type": "number"
              },
              "anyTrue": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              },
              "allTrue": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              },
              "noneTrue": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              },
              "falseCriterion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "always": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "required-sum"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "failureResultId": {
                "type": "string",
                "minLength": 1
              },
              "failureScore": {
                "type": "number"
              }
            }
          }
        }
      ]
    }
  }
}
